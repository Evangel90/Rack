# Stacks network
NEXT_PUBLIC_STACKS_NETWORK=testnet
NEXT_PUBLIC_HIRO_API_URL=https://api.testnet.hiro.so

# sBTC token on Stacks testnet (verified on-chain 2026-09-23; the ST1F7…sbtc-token id in some docs snippets does not exist on testnet)
NEXT_PUBLIC_SBTC_CONTRACT=SN3VMHXEN64ZZF71JQ5VESXDWTR301XTTXGF4J8F1.sbtc-token
NEXT_PUBLIC_SBTC_ASSET=sbtc-token

# USDCx on Stacks testnet (asset name usdcx-token, 6 decimals). Leave empty to hide the balance.
NEXT_PUBLIC_USDCX_CONTRACT=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM.usdcx
NEXT_PUBLIC_USDCX_ASSET=usdcx-token

# A fresh testnet Stacks address YOU control that receives airtime payments. Receive-only: no key needed here.
NEXT_PUBLIC_RACK_SETTLEMENT_ADDRESS=

# BTC price source (must return {"bitcoin":{"ngn":…,"usd":…}}). Default: CoinGecko simple price.
PRICE_API_URL=https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=ngn,usd

# 0 = mock biller always succeeds, 1 = always fails (demo the failure state)
MOCK_BILLER_FAIL_RATE=0

# sBTC deposit (Save) — the sbtc package's built-in testnet defaults are stale; these override them.
NEXT_PUBLIC_SBTC_DEPLOYER=SN3VMHXEN64ZZF71JQ5VESXDWTR301XTTXGF4J8F1
NEXT_PUBLIC_SBTC_EMILY_URL=https://beta.sbtc-emily.com

# Bitcoin network the sBTC signers watch (Stacks testnet uses regtest)
NEXT_PUBLIC_SBTC_BTC_NETWORK=regtest
# Optional: mempool-style API for that Bitcoin network, used server-side to fetch the raw deposit tx for Emily
SBTC_BTC_API_URL=
# Optional: block explorer for that Bitcoin network (links in Activity and Save)
NEXT_PUBLIC_SBTC_BTC_EXPLORER_URL=
